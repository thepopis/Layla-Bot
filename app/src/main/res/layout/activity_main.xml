<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Cabecera -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/tv_fecha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="#B8C4D2"
                android:textSize="12sp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Layla Bot"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:letterSpacing="0.15"
                android:text="PANEL DE CONTROL"
                android:textColor="#B8C4D2"
                android:textSize="12sp"/>
        </LinearLayout>

        <!-- Contenido -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Fila: estado + actualizar + copiar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <View
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_logo"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Layla Bot Activo"
                            android:textColor="#2B323C"
                            android:textSize="16sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/tv_servicio"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"/>
                    </LinearLayout>
                </LinearLayout>

                <Button
                    android:id="@+id/btn_actualizar"
                    android:layout_width="78dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_button"
                    android:drawableTop="@drawable/ic_refresh"
                    android:padding="8dp"
                    android:stateListAnimator="@null"
                    android:text="Actualizar"
                    android:textColor="#3A4452"
                    android:textSize="10sp"/>

                <Button
                    android:id="@+id/btn_copiar"
                    android:layout_width="78dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_button"
                    android:drawableTop="@drawable/ic_copy"
                    android:padding="8dp"
                    android:stateListAnimator="@null"
                    android:text="Copiar"
                    android:textColor="#3A4452"
                    android:textSize="10sp"/>
            </LinearLayout>

            <!-- Accesos rápidos -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:letterSpacing="0.1"
                android:text="ACCESOS RÁPIDOS"
                android:textColor="#3A4452"
                android:textSize="12sp"
                android:textStyle="bold"/>

            <Button
                android:id="@+id/btn_prueba"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_button"
                android:stateListAnimator="@null"
                android:text="Prueba de escritura (6 s)"
                android:textColor="#2B323C"/>

            <Button
                android:id="@+id/btn_siguiente"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_button"
                android:stateListAnimator="@null"
                android:text="Prueba siguiente chat (6 s)"
                android:textColor="#2B323C"/>

            <Button
                android:id="@+id/btn_ajustes"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_button"
                android:stateListAnimator="@null"
                android:text="Ajustes de accesibilidad"
                android:textColor="#2B323C"/>

            <!-- Aviso (solo si el servicio está apagado) -->
            <TextView
                android:id="@+id/aviso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_warning"
                android:padding="12dp"
                android:text="⚠  El servicio de accesibilidad no está activo. Toca aquí para activarlo en Ajustes."
                android:textColor="#7A5B00"
                android:textSize="13sp"
                android:visibility="gone"/>

            <!-- Estado -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="ESTADO"
                    android:textColor="#6B7785"
                    android:textSize="11sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tv_estado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#1F2933"
                    android:textSize="14sp"/>
            </LinearLayout>

            <!-- Último mensaje entrante -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="ÚLTIMO MENSAJE ENTRANTE"
                    android:textColor="#6B7785"
                    android:textSize="11sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tv_ultimo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#1F2933"
                    android:textSize="14sp"/>
            </LinearLayout>

            <!-- Conversación -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="CONVERSACIÓN VISIBLE"
                    android:textColor="#6B7785"
                    android:textSize="11sp"
                    android:textStyle="bold"/>

                <LinearLayout
                    android:id="@+id/ll_chat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="vertical"/>
            </LinearLayout>

            <!-- Conexión con la IA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="CONEXIÓN CON LA IA"
                    android:textColor="#6B7785"
                    android:textSize="11sp"
                    android:textStyle="bold"/>

                <EditText
                    android:id="@+id/et_cf_account"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_button"
                    android:hint="Cloudflare Account ID"
                    android:inputType="textNoSuggestions"
                    android:padding="12dp"
                    android:textSize="14sp"/>

                <EditText
                    android:id="@+id/et_cf_token"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_button"
                    android:hint="Cloudflare API Token"
                    android:inputType="textPassword"
                    android:padding="12dp"
                    android:textSize="14sp"/>

                <EditText
                    android:id="@+id/et_api_key"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_button"
                    android:hint="Gemini API Key (opcional, respaldo)"
                    android:inputType="textPassword"
                    android:padding="12dp"
                    android:textSize="14sp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_guardar_key"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_button"
                        android:stateListAnimator="@null"
                        android:text="Guardar"
                        android:textColor="#2B323C"
                        android:textSize="13sp"/>

                    <Button
                        android:id="@+id/btn_probar_ia"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_button_primary"
                        android:stateListAnimator="@null"
                        android:text="Probar IA"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_ia_estado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="#6B7785"
                    android:textSize="12sp"/>

                <TextView
                    android:id="@+id/tv_resultado_ia"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="#1F2933"
                    android:textIsSelectable="true"
                    android:textSize="12sp"/>
            </LinearLayout>

            <!-- Detalles técnicos (plegable) -->
            <TextView
                android:id="@+id/tv_detalles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:letterSpacing="0.08"
                android:padding="14dp"
                android:text="DETALLES TÉCNICOS  ▾"
                android:textColor="#3A4452"
                android:textSize="12sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/salida"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_card"
                android:padding="14dp"
                android:textColor="#1F2933"
                android:textIsSelectable="true"
                android:textSize="11sp"
                android:typeface="monospace"
                android:visibility="gone"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>